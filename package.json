{
  "name": "herness-config",
  "private": true,
  "packageManager": "bun@1.3.12",
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts",
    "start": "bun server.ts",
    "check": "bun build server.ts public/app.js --target bun --outdir /tmp/herness-config-check",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "bun test && playwright test && bun run check"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
